# ---------------------------------------------------------------- Discord (required to run the bot)
# Developer Portal -> your application -> Bot -> Reset Token. Never commit the real value.
DISCORD_BOT_TOKEN=
# Right-click your server -> Copy Server ID (needs Developer Mode). Makes slash commands appear instantly.
DISCORD_GUILD_ID=
# Right-click your own name -> Copy User ID. Only this account can subscribe/administer the bot.
# Leave empty to let the first person who runs /subscribe become the owner.
DISCORD_USER_ID=
# Optional: post new internships in this server channel instead of DMs (right-click channel -> Copy Channel ID).
# You can also just run /notify_here in the channel (and /notify_dm to switch back); the command wins over this.
NOTIFY_CHANNEL_ID=

# ---------------------------------------------------------------- Scanning
SCAN_INTERVAL_MINUTES=30
DATABASE_URL=sqlite:///./jobs.db
LOG_LEVEL=INFO
# Company boards and aggregators to check (see sources.toml)
SOURCES_FILE=sources.toml

# ---------------------------------------------------------------- Filtering
# Province codes in priority order (first = highest priority)
TARGET_PROVINCES=QC,ON
TARGET_CITIES=Montreal,Quebec City,Toronto,Waterloo,Ottawa
# Terms in priority order
TARGET_TERMS=Summer 2027,Fall 2027,Winter 2027
# Role categories to keep. Available: software, platform, ai_ml, data_engineering, security, qa,
# quant_dev, data_science, research, general, analytics, hardware, it_support, product_design, non_engineering
INCLUDED_CATEGORIES=software,platform,ai_ml,data_engineering,security,qa,quant_dev,data_science,research,general
# Title keywords that always exclude a posting (comma separated)
EXCLUDED_KEYWORDS=unpaid,volunteer,bénévole
INCLUDE_NEW_GRAD=false
ALLOW_UNPAID=false
# Keep postings whose location can't be determined (e.g. just "Remote"), with a lower score
INCLUDE_UNKNOWN_LOCATION=true
# Jobs below this score are discarded
MIN_RELEVANCE_SCORE=40

# ---------------------------------------------------------------- Notifications
# Jobs at or above this score get an immediate DM (others are stored; see /latest)
NOTIFY_MIN_SCORE=55
# Max individual DMs per scan; the rest are sent on following scans (never twice)
MAX_DMS_PER_SCAN=25
# When a source is checked successfully for the first time, only its best N matches are DM'd;
# the rest are stored silently and summarised in one message.
BASELINE_NOTIFY_LIMIT=10
# Undelivered notifications older than this are not sent anymore
PENDING_MAX_AGE_DAYS=3
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_HOUR=9
TIMEZONE=America/Toronto
# Full list of every match found since the start, rewritten after each scan. Open it in your browser
# and refresh. Leave empty to turn off.
EXPORT_HTML_PATH=internships.html

# ---------------------------------------------------------------- HTTP (rarely needs changing)
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
SOURCE_CONCURRENCY=6
MAX_DETAIL_REQUESTS_PER_SOURCE=40
